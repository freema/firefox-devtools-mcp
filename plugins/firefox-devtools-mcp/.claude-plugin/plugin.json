{
  "name": "firefox-devtools-mcp",
  "version": "0.10.6",
  "description": "Community packaging of Mozilla Firefox DevTools MCP for browsing, web testing, and debugging. Control Firefox, fill forms, take screenshots, and inspect network and console activity.",
  "author": {
    "name": "Tomas Grasl",
    "url": "https://github.com/freema"
  },
  "repository": "https://github.com/freema/firefox-devtools-mcp",
  "homepage": "https://github.com/mozilla/firefox-devtools-mcp",
  "license": "MIT OR Apache-2.0",
  "mcpServers": {
    "firefox-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "@mozilla/firefox-devtools-mcp@0.10.6",
        "--auto-profile",
        "--tool-preset",
        "developer",
        "--pref",
        "remote.prefs.recommended=false"
      ]
    }
  }
}
